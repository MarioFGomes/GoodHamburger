@page "/customers"
@inject CustomerService CustomerSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Customers — GoodHamburger</PageTitle>

<div class="space-y-6 max-w-5xl mx-auto">

    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-zinc-900 font-lexend">Customers</h1>
            <p class="text-sm text-zinc-500 mt-1">Manage your customer base</p>
        </div>
        <a href="customers/create" class="gh-btn gh-btn-primary">
            <span class="material-symbols-outlined" style="font-size:18px">person_add</span>
            New Customer
        </a>
    </div>

    @if (_error is not null) {
        <div class="flex items-center gap-3 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700">
            <span class="material-symbols-outlined text-red-500">error</span>
            <p class="text-sm">@_error</p>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-zinc-100 overflow-hidden">
        @if (_loading) {
            <div class="flex items-center justify-center py-16">
                <div class="flex items-center gap-3 text-zinc-400">
                    <span class="material-symbols-outlined animate-spin">refresh</span>
                    <span class="text-sm">Loading customers...</span>
                </div>
            </div>
        } else if (_paged is null || _paged.Items.Count == 0) {
            <div class="flex flex-col items-center justify-center py-16 text-zinc-400">
                <span class="material-symbols-outlined text-5xl mb-3">group</span>
                <p class="text-sm font-medium">No customers found</p>
                <p class="text-xs mt-1">Create the first customer to get started</p>
            </div>
        } else {
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-stone-50 border-b border-zinc-100">
                        <tr>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Name</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Email</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Phone</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-50">
                        @foreach (var c in _paged.Items) {
                            <tr class="hover:bg-stone-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center shrink-0">
                                            <span class="text-secondary-fixed text-xs font-bold">@(c.FirstName?.Substring(0,1).ToUpper())@(c.LastName?.Substring(0,1).ToUpper())</span>
                                        </div>
                                        <span class="font-medium text-zinc-900 text-sm">@c.FirstName @c.LastName</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-zinc-600">@c.Email</td>
                                <td class="px-6 py-4 text-sm text-zinc-600">@c.Phone</td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a href="customers/edit/@c.Id" class="gh-btn-sm gh-btn-edit">
                                            <span class="material-symbols-outlined" style="font-size:14px">edit</span>
                                            Edit
                                        </a>
                                        <button class="gh-btn-sm gh-btn-danger" @onclick="() => DeleteAsync(c.Id)">
                                            <span class="material-symbols-outlined" style="font-size:14px">delete</span>
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pagination CurrentPage="_page" TotalPages="_paged.TotalPages" OnPageChange="LoadPage" />
        }
    </div>

</div>

@code {
    private PagedResponse<CustomerResponse>? _paged;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page) {
        _loading = true; _error = null; _page = page;
        var result = await CustomerSvc.GetAllAsync(page);
        if (result.IsSuccess) _paged = result.Data;
        else _error = result.ErrorMessage;
        _loading = false;
    }

    private async Task DeleteAsync(Guid id) {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this customer?")) return;
        var result = await CustomerSvc.DeleteAsync(id);
        if (result.IsSuccess) await LoadPage(_page);
        else _error = result.ErrorMessage;
    }
}
