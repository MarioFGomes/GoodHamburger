@page "/menus"
@inject MenuService MenuSvc
@inject IJSRuntime JS

<PageTitle>Menu — GoodHamburger</PageTitle>

<div class="space-y-6 max-w-5xl mx-auto">

    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-zinc-900 font-lexend">Menu</h1>
            <p class="text-sm text-zinc-500 mt-1">Manage sandwich items and pricing</p>
        </div>
        <a href="menus/create" class="gh-btn gh-btn-primary">
            <span class="material-symbols-outlined" style="font-size:18px">add</span>
            New Item
        </a>
    </div>

    @if (_error is not null) {
        <div class="flex items-center gap-3 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700">
            <span class="material-symbols-outlined text-red-500">error</span>
            <p class="text-sm">@_error</p>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-zinc-100 overflow-hidden">
        @if (_loading) {
            <div class="flex items-center justify-center py-16">
                <div class="flex items-center gap-3 text-zinc-400">
                    <span class="material-symbols-outlined animate-spin">refresh</span>
                    <span class="text-sm">Loading menu...</span>
                </div>
            </div>
        } else if (_paged is null || _paged.Items.Count == 0) {
            <div class="flex flex-col items-center justify-center py-16 text-zinc-400">
                <span class="material-symbols-outlined text-5xl mb-3">restaurant_menu</span>
                <p class="text-sm font-medium">No menu items yet</p>
            </div>
        } else {
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-stone-50 border-b border-zinc-100">
                        <tr>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Name</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Price</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Currency</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold">Status</th>
                            <th class="px-6 py-4 text-xs text-zinc-500 uppercase tracking-wider font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-50">
                        @foreach (var m in _paged.Items) {
                            <tr class="hover:bg-stone-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-stone-100 flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-zinc-500" style="font-size:16px;font-variation-settings:'FILL' 1">lunch_dining</span>
                                        </div>
                                        <span class="font-medium text-zinc-900 text-sm">@m.Name</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-semibold text-zinc-900 text-sm">R$ @m.Price?.ToString("F2")</td>
                                <td class="px-6 py-4 text-sm text-zinc-500">@m.Currency</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                        @(m.Status == MenuStatus.Available ? "bg-emerald-100 text-emerald-700" : "bg-zinc-100 text-zinc-500")">
                                        @m.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a href="menus/edit/@m.Id" class="gh-btn-sm gh-btn-edit">
                                            <span class="material-symbols-outlined" style="font-size:14px">edit</span>
                                            Edit
                                        </a>
                                        <button class="gh-btn-sm gh-btn-danger" @onclick="() => DeleteAsync(m.Id)">
                                            <span class="material-symbols-outlined" style="font-size:14px">delete</span>
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pagination CurrentPage="_page" TotalPages="_paged.TotalPages" OnPageChange="LoadPage" />
        }
    </div>

</div>

@code {
    private PagedResponse<MenuResponse>? _paged;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page) {
        _loading = true; _error = null; _page = page;
        var result = await MenuSvc.GetAllAsync(page);
        if (result.IsSuccess) _paged = result.Data;
        else _error = result.ErrorMessage;
        _loading = false;
    }

    private async Task DeleteAsync(Guid id) {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this menu item?")) return;
        var result = await MenuSvc.DeleteAsync(id);
        if (result.IsSuccess) await LoadPage(_page);
        else _error = result.ErrorMessage;
    }
}
