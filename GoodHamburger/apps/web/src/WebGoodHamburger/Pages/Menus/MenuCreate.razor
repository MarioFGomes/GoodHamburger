@page "/menus/create"
@inject MenuService MenuSvc
@inject NavigationManager Nav

<PageTitle>New Menu Item — GoodHamburger</PageTitle>

<div class="max-w-2xl mx-auto space-y-6">

    <div class="flex items-center gap-4">
        <a href="/menus" class="p-2 hover:bg-stone-100 rounded-lg transition-colors text-zinc-500">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-zinc-900 font-lexend">New Menu Item</h1>
            <p class="text-sm text-zinc-500 mt-0.5">Add a new sandwich to the menu</p>
        </div>
    </div>

    @if (_error is not null) {
        <div class="flex items-center gap-3 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700">
            <span class="material-symbols-outlined text-red-500">error</span>
            <p class="text-sm">@_error</p>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-zinc-100 p-6">
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="block text-sm font-medium text-zinc-700">Name</label>
                    <InputText class="gh-input" @bind-Value="_model.Name" placeholder="Truffle Signature" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
                <div class="space-y-1">
                    <label class="block text-sm font-medium text-zinc-700">Description <span class="text-zinc-400 font-normal">(optional)</span></label>
                    <InputTextArea class="gh-textarea" @bind-Value="_model.Description" placeholder="Describe this item..." rows="3" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="block text-sm font-medium text-zinc-700">Price</label>
                        <InputNumber class="gh-input" @bind-Value="_model.Price" placeholder="0.00" />
                        <ValidationMessage For="() => _model.Price" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-sm font-medium text-zinc-700">Currency</label>
                        <InputSelect class="gh-select" @bind-Value="_model.Currency">
                            @foreach (var v in Enum.GetValues<Currency>()) {
                                <option value="@v">@v</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="flex gap-3 mt-6 pt-6 border-t border-zinc-100">
                <button type="submit" class="gh-btn gh-btn-primary" disabled="@_saving">
                    @if (_saving) {
                        <span class="material-symbols-outlined animate-spin" style="font-size:16px">refresh</span>
                        <span>Saving...</span>
                    } else {
                        <span class="material-symbols-outlined" style="font-size:16px">check</span>
                        <span>Create Item</span>
                    }
                </button>
                <a href="/menus" class="gh-btn gh-btn-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>

</div>

@code {
    private readonly CreateMenuRequest _model = new();
    private bool _saving;
    private string? _error;

    private async Task SubmitAsync() {
        _saving = true; _error = null;
        var result = await MenuSvc.CreateAsync(_model);
        if (result.IsSuccess) Nav.NavigateTo("/menus");
        else { _error = result.ErrorMessage; _saving = false; }
    }
}
