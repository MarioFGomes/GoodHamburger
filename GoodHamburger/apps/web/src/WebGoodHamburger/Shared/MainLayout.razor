@inherits LayoutComponentBase

<NavMenu />

<div class="md:ml-64 min-h-screen flex flex-col">

    <header class="bg-white/90 backdrop-blur-md border-b border-zinc-100 shadow-sm flex justify-between items-center h-16 px-6 sticky top-0 z-40">
        <h2 class="text-lg font-semibold text-zinc-900 font-lexend tracking-tight">GoodHamburger</h2>
        <div class="flex items-center gap-4">
            <div class="relative hidden sm:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400" style="font-size:18px">search</span>
                <input class="pl-9 pr-4 py-1.5 bg-zinc-100 rounded-full text-sm focus:ring-2 focus:ring-secondary-container focus:outline-none w-52 border-none"
                       placeholder="Search..." type="text" />
            </div>
            <button class="text-zinc-500 hover:text-zinc-900 transition-colors p-1">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button class="text-zinc-500 hover:text-zinc-900 transition-colors p-1">
                <span class="material-symbols-outlined">settings</span>
            </button>
            <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-secondary-fixed" style="font-size:16px;font-variation-settings:'FILL' 1">person</span>
            </div>
        </div>
    </header>

    <main class="flex-1 p-6 pb-24 md:pb-6">
        @Body
    </main>

    <footer class="py-5 px-6 border-t border-zinc-100 bg-white">
        <div class="flex flex-col md:flex-row justify-between items-center gap-2">
            <p class="text-zinc-400 text-xs">© 2024 GoodHamburger Management. Internal Use Only.</p>
            <div class="flex items-center gap-4 text-zinc-400 text-xs">
                <span class="hover:text-zinc-700 cursor-pointer transition-colors">Privacy Policy</span>
                <span class="hover:text-zinc-700 cursor-pointer transition-colors">Support</span>
                <span class="hover:text-zinc-700 cursor-pointer transition-colors">System Status</span>
            </div>
        </div>
    </footer>

</div>
